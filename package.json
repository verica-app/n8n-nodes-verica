{
  "name": "n8n-nodes-verica",
  "version": "0.2.3",
  "description": "LLM observability for your AI Agent and LLM steps: send each execution to Verica as a trace with tool calls, tokens and cost.",
  "license": "MIT",
  "author": {
    "name": "Verica",
    "email": "support@verica.app"
  },
  "keywords": [
    "n8n-community-node-package",
    "verica",
    "observability",
    "monitoring",
    "tracing",
    "llm",
    "ai-agent"
  ],
  "homepage": "https://verica.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verica-app/n8n-nodes-verica.git"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/VericaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/VericaTrace/VericaTrace.node.js"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "n8n-node build && cp nodes/VericaTrace/VericaTrace.node.json dist/nodes/VericaTrace/",
    "dev:node": "n8n-node dev",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.42.1",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
